# ── App ──────────────────────────────────────────────────────
APP_NAME=VitalPath AI
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=["https://vitalpath.app","https://app.vitalpath.io"]

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vitalpath:secret@postgres:5432/vitalpath

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_BUCKET_VIDEOS=wellness-videos

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=user_wellness_context

# ── Llama 4 (Together AI) ─────────────────────────────────────
LLAMA4_API_URL=https://api.together.xyz
LLAMA4_API_KEY=your-together-ai-key
LLAMA4_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# ── Qwen 3.5 VL (Together AI) ────────────────────────────────
QWEN_API_URL=https://api.together.xyz
QWEN_API_KEY=your-together-ai-key
QWEN_VL_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
QWEN_TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── Circuit Breaker ───────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
