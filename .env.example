# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_WEBHOOK_SECRET=<random-32-char-secret>

# Direct Postgres URL (used by FastAPI via asyncpg + pgvector)
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Required for:
#  - Defect detection (Claude Vision + extended thinking)
#  - Reasoning with prompt caching (cargo, inventory, shipment analysis)
#  - Item classification using Claude
ANTHROPIC_API_KEY=<anthropic-api-key>

# ── Voyage AI (embeddings for pgvector similarity search) ────────────────────
# Optional — falls back to ANTHROPIC_API_KEY for embedding calls
# Get a key at https://www.voyageai.com/
VOYAGE_API_KEY=<voyage-api-key>

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=<gemini-api-key>

# ── OpenClaw ──────────────────────────────────────────────────────────────────
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_TOKEN=<openclaw-api-token>
OPENCLAW_WEBHOOK_SECRET=<random-32-char-secret>

# ── Social Media APIs (legacy VideoFeed routes) ───────────────────────────────
YOUTUBE_API_KEY=<youtube-data-api-v3-key>
SPOTIFY_CLIENT_ID=<spotify-app-client-id>
SPOTIFY_CLIENT_SECRET=<spotify-app-client-secret>
SOUNDCLOUD_CLIENT_ID=<soundcloud-client-id>

# ── Service URLs ──────────────────────────────────────────────────────────────
PORT=8080
PY_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# ── iOS / Android app (set in Xcode scheme / build.gradle.kts) ───────────────
GO_API_URL=http://localhost:8080
