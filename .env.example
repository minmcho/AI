# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_WEBHOOK_SECRET=<random-32-char-secret>

# ── Database (direct Postgres for Python FastAPI) ──────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=<gemini-api-key>

# ── OpenClaw ──────────────────────────────────────────────────────────────────
OPENCLAW_API_URL=http://localhost:3000
OPENCLAW_TOKEN=<openclaw-api-token>
OPENCLAW_WEBHOOK_SECRET=<random-32-char-secret>
ANTHROPIC_API_KEY=<anthropic-key>   # used by OpenClaw as LLM backend

# ── Social Media APIs ─────────────────────────────────────────────────────────
YOUTUBE_API_KEY=<youtube-data-api-v3-key>
SPOTIFY_CLIENT_ID=<spotify-app-client-id>
SPOTIFY_CLIENT_SECRET=<spotify-app-client-secret>
SOUNDCLOUD_CLIENT_ID=<soundcloud-client-id>
# TikTok and Instagram use scraping / official APIs via OpenClaw skills

# ── Go API Gateway ────────────────────────────────────────────────────────────
PORT=8080
PY_API_URL=http://localhost:8000

# ── iOS App (set in Xcode scheme environment variables) ───────────────────────
GO_API_URL=http://localhost:8080
PY_API_URL=http://localhost:8000
